// spire-app FlatBuffers Schema — Top-Level Message Envelope
// The single wire-format contract between UI layer and Rust core.
// Application code determines which root type to parse (Envelope vs Reply).

namespace spire;

// === Command union — all request types ===

union Command {
    SendMessage,
    ExecuteTool,
    CancelStream,
    GetStatus,
    Shutdown,
}

// === ResponsePayload union — all response types ===

union ResponsePayload {
    MessageResponse,
    ToolResult,
    TokenStreamChunk,
    StatusResponse,
    ErrorResponse,
    Ack,
}

// === Envelope: request from UI → Core ===

table Envelope {
    id:       uint32;     // correlation ID for matching replies
    command:  Command;
}

// === Reply: response from Core → UI ===

table Reply {
    id:       uint32;
    payload:  ResponsePayload;
}

// === Command types ===

table SendMessage { content: string; }
table ExecuteTool  { tool: string; params: string; }
table CancelStream { stream_id: uint32; }
table GetStatus {}

// === Response types ===

table MessageResponse  { content: string; }
table ToolResult       { output: string; }
table TokenStreamChunk { stream_id: uint32; token: string; }
table StatusResponse   { status: string; }
table ErrorResponse    { code: int32; message: string; }
table Shutdown {}
table Ack {}